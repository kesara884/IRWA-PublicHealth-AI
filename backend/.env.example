# PublicHealth-AI — Environment Variables (copy to .env and fill in values)
# NEVER commit real .env files or API keys.

# --- App ---
APP_NAME=PublicHealth-AI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- CORS (frontend Vite default) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- JWT Authentication (Phase 11) ---
# Generate a long random string for production demos
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM Provider (Phase 8) ---
# Supported (planned): openai | stub
# Use "stub" for demos without an API key (template answers from evidence only)
LLM_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Retrieval (Phases 3–5) ---
TOP_K=5
# tfidf works on Python 3.13; use sentence_transformers on Python 3.10–3.12 with torch installed
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
SAMPLE_DOCUMENTS_PATH=./data/sample_documents
PROCESSED_DATA_PATH=./data/processed
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- Agent communication ---
# Base URL used when Agent 1 calls Agent 2 over HTTP/REST
AGENT_API_BASE_URL=http://127.0.0.1:8000
